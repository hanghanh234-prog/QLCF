  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">QPushButton:hover {
    background-color: #DFD4C5;
}

/* Nút đang được chọn (active) */
QPushButton:pressed, QPushButton:checked {
    background-color: #DFD4C5;
    font-weight: bold;
}

/* 4. Các khung nội dung màu trắng (Cards) bên phải */
QFrame {
    background-color: #FFFFFF;
    border-radius: 8px;
}

/* 5. Ô nhập liệu (QLineEdit, QComboBox, QDateEdit) */
QLineEdit, QComboBox, QDateEdit {
    background-color: #FAFAFA;
    border: 1px solid #E0D6CC;
    border-radius: 6px;
    padding: 6px 10px;
    color: #333333;
}

/* 6. Bảng dữ liệu (QTableWidget) */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #EFE9DF;
    gridline-color: #F0EBE3;
    border-radius: 6px;
}
QHeaderView::section {
    background-color: #F4EFE6;
    color: #5C4B41;
    padding: 8px;
    border: none;
    font-weight: bold;
}</string>
   </property>
