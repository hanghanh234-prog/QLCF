  <property name="styleSheet">
   <string notr="true">/* 1. Đổi màu nền toàn bộ cửa sổ sang màu kem nhạt */
QMainWindow {
    background-color: #F7F4EF;
    font-size: 15px;
}

/* 2. Thanh menu bên trái (Sidebar) */
QWidget#sidebarWidget, QFrame#frame {
    background-color: #EFE9DF;
    border-right: 1px solid #E2D9CD;
}

/* 3. Kiểu dáng các nút bấm trên menu trái */
QPushButton {
    background-color: transparent;
    border: none;
    text-align: left;
    padding: 10px 15px;
    color: #4A3B32;
    font-size: 15px;
    border-radius: 6px;
    margin: 2px 5px;
}
QPushButton:hover {
    background-color: #DFD4C5;
}

/* Nút đang được chọn (active) */
QPushButton:pressed,
QPushButton:checked {
    background-color: #DFD4C5;
    font-weight: bold;
}

/* 4. Các khung nội dung màu trắng (Cards) bên phải - Trừ khung chính tổng thể của cửa sổ */
QFrame#frame_2, QFrame#frame_3 {
    background-color: #FFFFFF;
    border-radius: 8px;
}

/* 5. Ô nhập liệu (QLineEdit, QComboBox, QDateEdit, QSpinBox) */
QLineEdit, QComboBox, QDateEdit, QSpinBox {
    background-color: #FAFAFA;
    border: 1px solid #E0D6CC;
    border-radius: 6px;
    padding: 6px 10px;
    color: #333333;
    font-size: 15px;
    min-height: 28px;
}

/* 6. Bảng dữ liệu (QTableWidget) */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #EFE9DF;
    gridline-color: #F0EBE3;
    border-radius: 6px;
    font-size: 15px;
}
QHeaderView::section {
    background-color: #F4EFE6;
    color: #5C4B41;
    padding: 8px;
    border: none;
    font-weight: bold;
    font-size: 15px;
}

/* 7. Nút Lưu phiếu nhập màu nâu đậm (Khớp với objectName: btnLuuPhieuNhap trong hình) */
QPushButton#btnLuuPhieuNhap {
    background-color: #5A3E2B;
    color: white;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 15px;
}
QPushButton#btnLuuPhieuNhap:hover {
    background-color: #463021;
}

/* 8. Nút Xóa dòng màu đỏ hồng nhẹ (Khớp với objectName: btnXoaDong trong hình) */
QPushButton#btnXoaDong {
    background-color: #E06D6D;
    color: white;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 15px;
}
QPushButton#btnXoaDong:hover {
    background-color: #cc5c5c;
}</string>
