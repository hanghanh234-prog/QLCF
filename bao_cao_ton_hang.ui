            <property name="styleSheet">
             <string notr="true">QGroupBox#groupDieuKien {
    background-color: #FFFCF7;
    color: #493020;
    border: 1px solid #D8C8B8;
    border-radius: 8px;
    margin-top: 18px;
    padding: 12px;
    font-family: &quot;Segoe UI&quot;;
    font-size: 12pt;
    font-weight: bold;
}

QGroupBox#groupDieuKien::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #493020;
    background-color: #F7F3EC;
    font-size: 12pt;
    font-weight: bold;
}

QLabel {
    color: #493020;
    font-family: &quot;Segoe UI&quot;;
    font-size: 11pt;
    font-weight: bold;
    background-color: transparent;
    padding: 2px;

}

/* --- 1. TÙY CHỈNH CHO QCOMBOBOX (Nhân viên, Trạng thái) --- */
QComboBox {
    border: 1px solid #D5D5D5;
    border-radius: 4px;
    padding: 5px 10px;
    background-color: white;
    color: #333333;
}

QComboBox:hover {
    border: 1px solid #8B5A2B; /* Viền đổi màu nâu khi trỏ chuột vào */
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left-width: 0px; /* Bỏ đường kẻ thô bên trái mũi tên */
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* Thay thế mũi tên mặc định bằng icon/mũi tên tinh tế hơn hoặc làm phẳng nó */
QComboBox::down-arrow {
    image: none; /* Tắt hình mũi tên mặc định hệ thống nếu muốn thay bằng ký tự hoặc giữ nét thanh */
    border-image: none;
}

/* --- 2. TÙY CHỈNH CHO QDATEEDIT (Từ ngày, Đến ngày) --- */
QDateEdit {
    border: 1px solid #D5D5D5;
    border-radius: 4px;
    padding: 5px 10px;
    background-color: white;
    color: #333333;
}

QDateEdit:hover {
    border: 1px solid #8B5A2B;
}

/* Thu nhỏ và làm gọn nút bấm tăng/giảm (spinbox buttons) của QDateEdit */
QDateEdit::up-button, QDateEdit::down-button {
    width: 16px;
    border: none;
    background: transparent;
}

QDateEdit::up-button:hover, QDateEdit::down-button:hover {
    background-color: #EFEFEF;
    border-radius: 2px;
}</string>
